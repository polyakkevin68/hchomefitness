# Helyi fejlesztői PostgreSQL-kapcsolat. Titkot ne tegyél verziókezelésbe.
DATABASE_URL="postgresql://hc_dev:hc_dev@localhost:5432/hc_webaruhaz?schema=public"
DATABASE_POOL_MAX="10" # Kapcsolatonkénti PostgreSQL-készlet; méretezd a kiszolgálóhoz.
APP_ENV="development"
CATALOG_ADAPTER="fixture"
# Helyi UNAS-előnézethez fejlesztésben: CATALOG_ADAPTER="unas-preview"

# Külső szolgáltatások nincsenek bekapcsolva, amíg a hozzáférés nincs beállítva.
# API-kulcs kizárólag szerveroldali környezeti titokként adható meg.
# UNAS_API_KEY=""
# Az aktuális HC termékeken lévő „API engedélyezés” paraméter azonosítója.
# UNAS_HC_ALLOW_PARAM_ID="8773476"
PAYMENT_PROVIDER="disabled"
PUBLIC_BASE_URL=""
SIMPLEPAY_ENV="sandbox"
# SimplePay titkok csak helyi, szerveroldali .env fájlba vagy titokkezelőbe kerülhetnek.
# SIMPLEPAY_MERCHANT_ID=""
# SIMPLEPAY_MERCHANT_KEY=""
MAILERSEND_PROVIDER="disabled"
MAILERSEND_MODE="allowlist"
MAILERSEND_API_KEY=""
MAILERSEND_FROM_EMAIL=""
MAILERSEND_FROM_NAME="HC Home Fitness"
MAILERSEND_ALLOWED_RECIPIENTS=""
MAILERSEND_WEBHOOK_SECRET=""
NEWSLETTER_ENABLED="false"
NEWSLETTER_CONSENT_VERSION=""
NEWSLETTER_PRIVACY_URL=""
INVOICE_ACCESS_SECRET=""
PRICE_MAX_AGE_SECONDS="7200"
STOCK_MAX_AGE_SECONDS="7200"
ORDER_REQUESTS_ENABLED="false"
# Élesítéshez jóváhagyott tájékoztató-verziók és legalább 32 karakteres kezelői kulcs szükséges.
# ORDER_OPERATIONS_TOKEN=""
# ORDER_PRIVACY_NOTICE_VERSION=""
# ORDER_SALES_TERMS_VERSION=""
