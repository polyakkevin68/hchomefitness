generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id            String   @id @default(cuid())
  source        String
  sourceId      String
  sku           String   @unique
  slug          String   @unique
  name          String
  brand         String
  category      String   @default("Egyéb")
  description   String   @default("")
  longDescription String @default("")
  imageUrls     String[] @default([])
  attributes    Json     @default("[]")
  isPurchasable Boolean  @default(true)
  priceHuf      Int
  netPriceHuf   Decimal? @db.Decimal(12, 2)
  isPublished   Boolean  @default(false)
  isTestFixture Boolean  @default(false)
  isActive      Boolean  @default(true)
  sourceHash    String?
  lastImportedAt DateTime?
  sourceUpdated DateTime?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([source, sourceId])
  @@index([brand, isPublished])
  kosarTetelek   KosarTetel[]
  keszlet        ProductStock?
  ajanlokForraskent TermekAjanlo[] @relation("TermekAjanloForras")
  ajanlokCeltermekkent TermekAjanlo[] @relation("TermekAjanloCeltermek")
  ertekelesek    TermekErtekeles[]
}

model ProductStock {
  id        String   @id @default(cuid())
  productId String   @unique
  quantity  Float?
  rows      Json     @default("[]")
  fetchedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([fetchedAt])
}

model Kosar {
  id           String       @id @default(cuid())
  sessionHash  String       @unique
  version      Int          @default(0)
  szallitasiMod String?
  expiresAt    DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tetelek      KosarTetel[]
  ajanlatok     CheckoutQuote[]
  kuponFelhasznalasok KuponFelhasznalas[]

  @@index([expiresAt])
}

model KosarTetel {
  id         String   @id @default(cuid())
  kosarId    String
  termekId   String
  mennyiseg  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  kosar      Kosar    @relation(fields: [kosarId], references: [id], onDelete: Cascade)
  termek     Product  @relation(fields: [termekId], references: [id], onDelete: Restrict)

  @@unique([kosarId, termekId])
  @@index([termekId])
}

model CheckoutQuote {
  id                 String   @id @default(cuid())
  tokenHash          String   @unique
  kosarId            String
  cartVersion        Int
  itemSnapshots      Json
  szallitasiMod      String
  termekOsszegHuf    Int
  szallitasHuf       Int
  fizetendoHuf       Int
  kuponKod           String?
  kedvezmenyHuf      Int      @default(0)
  arSzabalyVerzio    Int      @default(1)
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  kosar              Kosar    @relation(fields: [kosarId], references: [id], onDelete: Cascade)
  kuponFelhasznalas  KuponFelhasznalas?

  @@index([kosarId, expiresAt])
  @@index([expiresAt])
}

model ImportRun {
  id               String    @id @default(cuid())
  source           String
  status           String    @default("RUNNING")
  isComplete       Boolean   @default(false)
  receivedCount    Int       @default(0)
  acceptedCount    Int       @default(0)
  excludedCount    Int       @default(0)
  invalidCount     Int       @default(0)
  createdCount     Int       @default(0)
  updatedCount     Int       @default(0)
  unchangedCount   Int       @default(0)
  deactivatedCount Int       @default(0)
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?

  @@index([source, startedAt])
}

model Order {
  id                      String       @id @default(cuid())
  publicId                String       @unique
  status                  String       @default("PENDING_CONFIRMATION")
  paymentState            String       @default("UNPAID")
  currency                String       @default("HUF")
  productTotalHuf         Int          @default(0)
  shippingFeeHuf          Int          @default(0)
  shippingMethod          String       @default("hazhoz")
  totalHuf                Int
  discountHuf             Int          @default(0)
  couponCode              String?
  customerName            String       @default("")
  customerEmail           String
  customerPhone           String       @default("")
  addressSnapshot         Json         @default("{}")
  itemSnapshots           Json         @default("[]")
  sourceQuoteId           String?
  privacyNoticeVersion    String?
  salesTermsVersion       String?
  sessionHash             String       @default("")
  guestAccessHash         String       @default("")
  requestHash             String       @default("")
  idempotencyKey          String
  stockConfirmationNote   String?
  stockConfirmedAt        DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  events                  OrderEvent[]
  paymentAttempts         PaymentAttempt[]
  shipment                Shipment?
  invoices                Invoice[]
  notifications           Notification[]
  ertekelesek             TermekErtekeles[]
  fiokId                  String?
  fiok                    VasarloiFiok? @relation(fields: [fiokId], references: [id], onDelete: SetNull)

  @@unique([sessionHash, idempotencyKey])
  @@index([status, createdAt])
  @@index([guestAccessHash])
}

model PaymentAttempt {
  id                 String        @id @default(cuid())
  orderId            String
  provider           String
  merchantRef        String        @unique
  providerPaymentId  String?
  state              String        @default("CREATED")
  amountHuf          Int
  currency           String        @default("HUF")
  attemptNo          Int
  paymentUrl         String?
  idempotencyKey     String
  expiresAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events             PaymentEvent[]
  refunds            Refund[]

  @@unique([orderId, attemptNo])
  @@unique([provider, providerPaymentId])
  @@unique([orderId, idempotencyKey])
  @@index([state, createdAt])
}

model PaymentEvent {
  id                 String          @id @default(cuid())
  provider           String
  eventFingerprint   String
  eventKey           String?
  paymentAttemptId   String?
  verifiedState      String?
  receivedAt         DateTime        @default(now())
  processedAt        DateTime?
  paymentAttempt     PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)

  @@unique([provider, eventFingerprint])
  @@index([receivedAt, processedAt])
  @@index([paymentAttemptId, receivedAt])
}

model Refund {
  id                 String         @id @default(cuid())
  paymentAttemptId   String
  amountHuf          Int
  reason             String
  state              String         @default("REQUESTED")
  providerRefundId   String?
  idempotencyKey     String         @unique
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  paymentAttempt     PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)

  @@index([paymentAttemptId, state])
}

model AdminUser {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  role           String
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  sessions       AdminSession[]
  auditEntries   AdminAuditLog[]
  loginAttempts  AdminLoginAttempt[]

  @@index([role, isActive])
}

model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt])
  @@index([expiresAt])
}

model AdminLoginAttempt {
  id             String     @id @default(cuid())
  adminUserId    String?
  identityHash   String
  sourceHash     String
  succeeded      Boolean    @default(false)
  createdAt      DateTime   @default(now())
  adminUser      AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([identityHash, sourceHash, succeeded, createdAt])
}

model AdminAuditLog {
  id          String    @id @default(cuid())
  adminUserId String?
  action      String
  targetType  String
  targetId    String?
  details     Json      @default("{}")
  createdAt   DateTime  @default(now())
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model Shipment {
  id             String   @id @default(cuid())
  orderId        String
  state          String   @default("PENDING")
  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  idempotencyKey String   @unique
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId])
  @@index([state, updatedAt])
}

model Invoice {
  id               String   @id @default(cuid())
  orderId          String
  provider         String   @default("disabled")
  state            String   @default("NOT_ISSUED")
  idempotencyKey   String   @unique
  externalId       String?
  invoiceNumber    String?
  privateDocumentKey String?
  documentPdf       Bytes?
  documentSha256    String?
  requestedAt      DateTime?
  issuedAt         DateTime?
  lastCheckedAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, state])
  @@index([state, updatedAt])
  @@unique([orderId])
}

model Notification {
  id                String   @id @default(cuid())
  orderId           String
  type              String
  dedupeKey         String   @unique
  state             String   @default("PENDING")
  attempts          Int      @default(0)
  providerMessageId String?
  lastError         String?
  sentAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([state, createdAt])
  @@index([orderId, type, createdAt])
}

model OrderEvent {
  id          String   @id @default(cuid())
  orderId     String
  fromStatus  String?
  toStatus    String
  actor       String
  note        String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model VasarloiFiok {
  id               String                @id @default(cuid())
  email            String                @unique
  jelszoHash       String
  nev              String                @default("")
  emailIgazolvaAt  DateTime?
  letiltvaAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  munkamenetek     VasarloiMunkamenet[]
  igazolasok       VasarloiEmailIgazolas[]
  cimek            VasarloiCim[]
  rendelesek       Order[]
  ertekelesek      TermekErtekeles[]

  @@index([emailIgazolvaAt, letiltvaAt])
}

model VasarloiMunkamenet {
  id             String        @id @default(cuid())
  fiokId         String
  tokenHash      String        @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())
  fiok           VasarloiFiok  @relation(fields: [fiokId], references: [id], onDelete: Cascade)

  @@index([fiokId, expiresAt])
  @@index([expiresAt])
}

model VasarloiEmailIgazolas {
  id             String        @id @default(cuid())
  fiokId         String
  tokenHash      String        @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime      @default(now())
  fiok           VasarloiFiok  @relation(fields: [fiokId], references: [id], onDelete: Cascade)

  @@index([fiokId, expiresAt])
}

model VasarloiCim {
  id             String        @id @default(cuid())
  fiokId         String
  nev            String
  iranyitoszam   String
  telepules      String
  cim            String
  alapertelmezett Boolean      @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  fiok           VasarloiFiok  @relation(fields: [fiokId], references: [id], onDelete: Cascade)

  @@index([fiokId, alapertelmezett])
}

model VasarloiBelepesiProba {
  id             String   @id @default(cuid())
  emailHash      String
  forrasHash     String
  sikeres        Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([emailHash, sikeres, createdAt])
  @@index([createdAt])
}

model Kupon {
  id                    String              @id @default(cuid())
  kod                   String              @unique
  tipus                 String
  ertek                 Int
  minimumHuf            Int                 @default(0)
  maximumHuf            Int?
  indulAt               DateTime
  lejarAt               DateTime
  felhasznalasiKeret    Int?
  aktiv                 Boolean             @default(false)
  osszevonhato          Boolean             @default(false)
  kategoriak            String[]            @default([])
  cikkszamok            String[]            @default([])
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  felhasznalasok        KuponFelhasznalas[]

  @@index([aktiv, indulAt, lejarAt])
}

model KuponFelhasznalas {
  id                 String        @id @default(cuid())
  kuponId            String
  kosarId            String
  checkoutQuoteId    String        @unique
  orderId            String?       @unique
  allapot            String        @default("RESERVED")
  kedvezmenyHuf      Int
  createdAt          DateTime      @default(now())
  usedAt             DateTime?
  kupon              Kupon         @relation(fields: [kuponId], references: [id], onDelete: Restrict)
  kosar              Kosar         @relation(fields: [kosarId], references: [id], onDelete: Cascade)
  checkoutQuote      CheckoutQuote @relation(fields: [checkoutQuoteId], references: [id], onDelete: Cascade)

  @@index([kuponId, allapot, createdAt])
  @@index([kosarId, allapot])
}

model TermekAjanlo {
  id             String   @id @default(cuid())
  forrasTermekId String
  celTermekId    String
  sorrend        Int      @default(0)
  aktiv          Boolean  @default(false)
  createdAt      DateTime @default(now())
  frissitveAt    DateTime @updatedAt
  forrasTermek   Product  @relation("TermekAjanloForras", fields: [forrasTermekId], references: [id], onDelete: Cascade)
  celTermek      Product  @relation("TermekAjanloCeltermek", fields: [celTermekId], references: [id], onDelete: Cascade)

  @@unique([forrasTermekId, celTermekId])
  @@index([forrasTermekId, aktiv, sorrend])
  @@index([celTermekId])
}

model HirlevelFeliratkozas {
  id                    String   @id @default(cuid())
  email                 String   @unique
  hozzajarultAt         DateTime
  hozzajarulasVerzio    String   @default("hirlevel-2026-09")
  igazolasHash          String
  igazolasLejarAt        DateTime
  igazolvaAt             DateTime?
  leiratkozasHash        String
  leiratkozottAt         DateTime?
  szolgaltatoiAllapot    String   @default("PENDING")
  szolgaltatoiUzenetId   String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([igazolvaAt, leiratkozottAt])
  @@index([igazolasLejarAt])
}

model TermekErtekeles {
  id              String        @id @default(cuid())
  productId       String
  orderId         String
  fiokId          String
  csillag         Int
  szoveg          String
  allapot         String        @default("PENDING")
  igazoltVasarlas Boolean       @default(true)
  moderaltaId     String?
  moderalvaAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  termek          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  rendeles        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fiok            VasarloiFiok  @relation(fields: [fiokId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId])
  @@index([productId, allapot, createdAt])
  @@index([fiokId, createdAt])
}

model TartalmiOldal {
  id          String   @id @default(cuid())
  slug        String   @unique
  cim         String
  bevezeto    String
  szekciok    Json     @default("[]")
  kintVan     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([kintVan, slug])
}
