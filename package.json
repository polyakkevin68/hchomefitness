    "unas:penznem": "node --conditions=react-server --import tsx scripts/unas-penznem.ts",
    "unas:elozetes": "node --conditions=react-server --import tsx scripts/unas-import-elozetes.ts",
    "unas:import:sorba": "node --conditions=react-server --import tsx scripts/unas-import-sorba.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed:test": "node --conditions=react-server --import tsx prisma/fejlesztoi-seed.ts",
    "check:production-config": "tsx scripts/eles-konfiguracio.ts",
    "m8:terhelesi-adatok": "node --conditions=react-server --import tsx scripts/m8-terhelesi-adatok.ts",
    "m8:terheles-meres": "node --import tsx scripts/m8-terheles-meres.ts",
