    "dotenv": "^16.4.7",
    "fast-xml-parser": "5.11.1",
    "next": "16.3.6",
    "pg": "^8.16.3",
    "pg-boss": "^12.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.3.6",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prisma": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.4"
